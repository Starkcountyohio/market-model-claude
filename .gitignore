# pointed to by the MARKET_MODEL_DATA env var. See config.py.
*.xlsx
*.xls
*.csv
*.tsv
*.html
*.pdf

# --- Scratch / exploration files (underscore-prefixed convention) ---
_*.py
_*.txt

# --- Local config overrides (per-machine) ---
config.local.py
