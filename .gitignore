# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.env

# --- Editor / OS noise ---
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*

# --- Per-user Claude memory (lives in ~/.claude regardless of project location) ---
.claude/

# --- DATA & GENERATED WORKBOOKS — these live in the shared OneDrive folder, not git ---
